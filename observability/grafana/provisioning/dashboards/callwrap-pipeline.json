{
  "title": "CallWrap Pipeline",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "처리량 (Job 발행 / 결과 수신)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(callwrap_job_published_total[5m])", "legendFormat": "job_published" },
        { "expr": "sum(rate(callwrap_result_received_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "상태별 비율",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(callwrap_result_received_total) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 3,
      "title": "처리 지연 (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "callwrap_job_processing_seconds{quantile=\"0.5\"}", "legendFormat": "p50" },
        { "expr": "callwrap_job_processing_seconds{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "callwrap_job_processing_seconds{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "title": "결과 큐 적재량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "callwrap_queue_depth", "legendFormat": "{{queue}}" }
      ]
    }
  ]
}
