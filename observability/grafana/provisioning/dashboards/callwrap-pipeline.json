{
  "title": "CallWrap Pipeline",
  "uid": "callwrap-pipeline",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "처리량 (Job 발행 / 결과 수신)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(callwrap_job_published_total[5m])", "legendFormat": "job_published" },
        { "expr": "sum(rate(callwrap_result_received_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "상태별 비율",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(callwrap_result_received_total) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 3,
      "title": "처리 지연 (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "callwrap_job_processing_seconds{quantile=\"0.5\"}", "legendFormat": "p50" },
        { "expr": "callwrap_job_processing_seconds{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "callwrap_job_processing_seconds{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "title": "결과 큐 적재량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "callwrap_queue_depth", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 5,
      "title": "스키마 위반 (Job / Result)",
      "description": "메시지 계약이 깨졌을 때만 오르는 지표 — 평소엔 0이어야 정상.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(callwrap_job_schema_violation_total[5m])", "legendFormat": "job_schema_violation" },
        { "expr": "sum(rate(callwrap_result_schema_violation_total[5m])) by (reason)", "legendFormat": "result: {{reason}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 40 },
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "title": "워커 유실로 스윕된 콜 (최근 1시간)",
      "description": "PROCESSING 상태로 timeout을 넘겨 StuckCallSweeper가 강제로 FAILED 처리한 건수. 0이 아니면 워커 쪽을 봐야 한다는 신호.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "increase(callwrap_stuck_call_swept_total[1h])", "legendFormat": "swept" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    }
  ]
}
