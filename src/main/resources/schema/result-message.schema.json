{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://callwrap.internal/schema/result-message.schema.json",
  "title": "ResultMessage",
  "type": "object",
  "required": ["schema_version", "call_id", "status", "completed_at"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "call_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["DONE", "NEEDS_HUMAN_REVIEW", "FAILED"] },
    "analysis": {
      "type": ["object", "null"],
      "properties": {
        "utterance_sentiments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["utterance_index", "speaker", "score"],
            "properties": {
              "utterance_index": { "type": "integer", "minimum": 0 },
              "speaker": { "type": "string", "enum": ["상담사", "고객"] },
              "score": { "type": "number", "minimum": -1, "maximum": 1 }
            }
          }
        }
      }
    },
    "transcript": { "type": ["object", "null"] },
    "quality": {
      "type": ["object", "null"],
      "properties": {
        "passed": { "type": "boolean" },
        "failed_checks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failures": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["string", "null"] },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "DONE" } } }, "then": { "required": ["analysis"] } },
    { "if": { "properties": { "status": { "const": "NEEDS_HUMAN_REVIEW" } } }, "then": { "required": ["quality"] } },
    { "if": { "properties": { "status": { "const": "FAILED" } } }, "then": { "required": ["error"] } }
  ]
}
